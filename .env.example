# Non-production example values only
POSTGRES_DB=mira_db
POSTGRES_USER=mira_user
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_PORT=5544

# API settings
API_PORT=8081
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

# Connection string consumed by the API from environment variables
ConnectionStrings__PostgreSql=Host=mira-postgres;Port=5432;Database=mira_db;Username=mira_user;Password=change_me_local_only
